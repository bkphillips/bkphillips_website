# Copy this file to .env.local and fill in the keys you have. Both are optional;
# without them the tools still work and the features below show a notice.

# NewsAPI.ai (newsapi.ai): finds articles around each shift in Inflection, and
# the news shown on the landing page's change points (analysis/add_terrain_news.ts).
NEWSAPI_AI_KEY=

# Anthropic: writes summaries in Inflection (from the news articles when both
# keys are set) and runs the Kestrel Org Explorer assistant.
ANTHROPIC_API_KEY=

# Optional limits on explanations, counted in shifts explained (defaults shown):
# per visitor per hour, and in total per day. They apply on the live site only.
# INFLECTION_HOURLY_LIMIT=40
# INFLECTION_DAILY_LIMIT=150
# Optional model override (default: claude-opus-5-5).
# INFLECTION_MODEL=

# Optional limits on assistant questions (defaults shown) and model override.
# ORG_CHAT_HOURLY_LIMIT=15
# ORG_CHAT_DAILY_LIMIT=300
# ORG_CHAT_MODEL=

# TMDB (themoviedb.org) "API Read Access Token": used only by an offline build
# script to look up film posters. It is not needed on the live site.
TMDB_READ_TOKEN=
