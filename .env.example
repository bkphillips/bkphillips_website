# Copy this file to .env.local and fill in the key to turn on the two AI
# features: news explanations in Inflection and the assistant in Org Health
# Explorer. Without it both tools still work; those features show a notice.
ANTHROPIC_API_KEY=

# Optional limits on explanation requests (defaults shown).
# INFLECTION_HOURLY_LIMIT=6
# INFLECTION_DAILY_LIMIT=150
# Optional model override (default: claude-opus-5-5).
# INFLECTION_MODEL=

# Optional limits on assistant questions (defaults shown) and model override.
# ORG_CHAT_HOURLY_LIMIT=15
# ORG_CHAT_DAILY_LIMIT=300
# ORG_CHAT_MODEL=
